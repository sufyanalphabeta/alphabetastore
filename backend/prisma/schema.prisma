generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum QnAStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
}

enum PaymentMethodCode {
  COD
  BANK_TRANSFER
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum ReceiptReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  NORMAL
  URGENT
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}

enum BaseCurrency {
  USD
  LYD
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaProcessingStatus {
  PROCESSING
  READY
  FAILED
}

enum ProductMediaRole {
  PRIMARY
  GALLERY
  VIDEO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum HomepageBlockType {
  FEATURED_CATEGORIES
  NEW_ARRIVALS
  BEST_SELLERS
  PROMOTIONS
  RECENTLY_ADDED
  FEATURED_BRANDS
  HERO_BANNER
  CUSTOM_PRODUCTS
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  TICKET_UPDATE
  SYSTEM
}

enum ProductRelationType {
  ACCESSORY
  FREQUENTLY_BOUGHT_TOGETHER
  RECOMMENDED
  COMPATIBLE
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum CatalogImportSourceSystem {
  RAKIZA
  GENERIC_CSV
}

enum CatalogImportFileFormat {
  CSV
  XLS
  XLSX
}

enum CatalogImportMode {
  PRODUCTS_ONLY
  PRICES_ONLY
  PRODUCTS_AND_PRICES
}

enum CatalogImportSessionStatus {
  UPLOADED
  ANALYZING
  READY_FOR_REVIEW
  APPROVED
  APPLYING
  COMPLETED
  FAILED
  CANCELLED
}

enum CatalogImportRowStatus {
  NEW
  UNCHANGED
  PRICE_CHANGED
  CATEGORY_CHANGED
  CONFLICT
  INVALID
  APPLIED
  SKIPPED
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String                 @db.VarChar(120)
  email                   String                 @unique @db.VarChar(255)
  phone                   String?                @db.VarChar(30)
  customerCode            String?                @unique @map("customer_code") @db.VarChar(8)
  preferredPaymentMethod  PaymentMethodCode      @default(COD) @map("preferred_payment_method")
  passwordHash            String                 @map("password_hash") @db.VarChar(255)
  role                    Role                   @default(CUSTOMER)
  status                  UserStatus             @default(ACTIVE)
  loginFailCount          Int                    @default(0) @map("login_fail_count")
  loginLockedUntil        DateTime?              @map("login_locked_until") @db.Timestamptz(6)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  addresses               Address[]
  carts                   Cart[]
  orders                  Order[]
  orderStatusChanges      OrderStatusHistory[]
  tickets                 Ticket[]
  ticketMessages          TicketMessage[]
  uploadedReceipts        BankTransferReceipt[]  @relation("BankTransferReceiptUploadedBy")
  reviewedReceipts        BankTransferReceipt[]  @relation("BankTransferReceiptReviewedBy")
  refreshTokens           RefreshToken[]
  serviceRequests         ServiceRequest[]
  wishlistItems           WishlistItem[]
  priceHistoryChanges     PriceHistory[]
  passwordResetTokens     PasswordResetToken[]
  reviews                 Review[]
  qnaItems                ProductQnA[]
  mediaAssets             MediaAsset[]
  initiatedImportSessions CatalogImportSession[] @relation("ImportInitiatedBy")
  approvedImportSessions  CatalogImportSession[] @relation("ImportApprovedBy")
  catalogReviewedProducts Product[]              @relation("ProductCatalogReviewedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String   @db.VarChar(80)
  fullName    String   @map("full_name") @db.VarChar(160)
  phone       String   @db.VarChar(30)
  city        String   @db.VarChar(120)
  addressLine String   @map("address_line") @db.VarChar(255)
  notes       String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@index([isDefault])
  @@map("addresses")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Category {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String            @db.VarChar(120)
  slug               String            @unique @db.VarChar(160)
  parentId           String?           @map("parent_id") @db.Uuid
  isActive           Boolean           @default(true) @map("is_active")
  isVisible          Boolean           @default(true) @map("is_visible")
  isFeatured         Boolean           @default(false) @map("is_featured")
  sortOrder          Int               @default(0) @map("sort_order")
  icon               String?           @db.VarChar(120)
  imageUrl           String?           @map("image_url") @db.VarChar(500)
  description        String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent             Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]        @relation("CategoryTree")
  products           Product[]
  attributeProfileId String?           @map("attribute_profile_id") @db.Uuid
  attributeProfile   AttributeProfile? @relation(fields: [attributeProfileId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([isActive])
  @@index([isVisible])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([attributeProfileId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  bannerUrl   String?   @map("banner_url") @db.VarChar(500)
  description String?   @db.Text
  metaTitle   String?   @map("meta_title") @db.VarChar(160)
  metaDesc    String?   @map("meta_desc") @db.VarChar(320)
  isVisible   Boolean   @default(true) @map("is_visible")
  isFeatured  Boolean   @default(false) @map("is_featured")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@index([isVisible])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("brands")
}

model Product {
  id                      String                  @id @default(uuid()) @db.Uuid
  categoryId              String                  @map("category_id") @db.Uuid
  name                    String                  @db.VarChar(160)
  slug                    String                  @unique @db.VarChar(180)
  description             String                  @db.Text
  shortDescription        String                  @map("short_description") @db.VarChar(255)
  price                   Decimal                 @db.Decimal(12, 4)
  baseCurrency            BaseCurrency            @default(LYD) @map("base_currency")
  exchangeRateOverride    Decimal?                @map("exchange_rate_override") @db.Decimal(12, 6)
  comparePrice            Decimal?                @map("compare_price") @db.Decimal(12, 4)
  discountType            DiscountType?           @map("discount_type")
  discountValue           Decimal?                @map("discount_value") @db.Decimal(12, 4)
  discountStartAt         DateTime?               @map("discount_start_at") @db.Timestamptz(6)
  discountEndAt           DateTime?               @map("discount_end_at") @db.Timestamptz(6)
  stockQty                Int                     @map("stock_qty")
  maxPurchaseQty          Int?                    @map("max_purchase_qty")
  status                  ProductStatus           @default(INACTIVE)
  brand                   String?                 @db.VarChar(120)
  brandId                 String?                 @map("brand_id") @db.Uuid
  sku                     String?                 @unique @db.VarChar(120)
  warrantyText            String?                 @map("warranty_text") @db.VarChar(120)
  datasheetUrl            String?                 @map("datasheet_url") @db.VarChar(500)
  specs                   Json?                   @db.JsonB
  highlights              Json?                   @db.JsonB
  isFeatured              Boolean                 @default(false) @map("is_featured")
  hasVariants             Boolean                 @default(false) @map("has_variants")
  viewCount               Int                     @default(0) @map("view_count")
  salesCount              Int                     @default(0) @map("sales_count")
  ratingAvg               Decimal                 @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount             Int                     @default(0) @map("rating_count")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  catalogReviewedAt       DateTime?               @map("catalog_reviewed_at") @db.Timestamptz(6)
  catalogReviewedByUserId String?                 @map("catalog_reviewed_by_user_id") @db.Uuid
  cartItems               CartItem[]
  orderItems              OrderItem[]
  category                Category                @relation(fields: [categoryId], references: [id])
  brandRef                Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images                  ProductImage[]
  media                   ProductMedia[]
  wishlistItems           WishlistItem[]
  priceHistory            PriceHistory[]
  recentlyViewed          RecentlyViewedItem[]
  reviews                 Review[]
  qnaItems                ProductQnA[]
  variants                ProductVariant[]
  sourceIdentities        ProductSourceIdentity[]
  catalogImportRows       CatalogImportRow[]
  sourceRelations         ProductRelation[]       @relation("SourceProduct")
  targetRelations         ProductRelation[]       @relation("TargetProduct")
  bundleItems             BundleItem[]
  catalogReviewedBy       User?                   @relation("ProductCatalogReviewedBy", fields: [catalogReviewedByUserId], references: [id], onDelete: SetNull)
  attributeValues         ProductAttributeValue[]

  @@index([categoryId])
  @@index([status])
  @@index([brand])
  @@index([brandId])
  @@index([sku])
  @@index([baseCurrency])
  @@index([categoryId, status])
  @@index([isFeatured])
  @@index([salesCount])
  @@index([viewCount])
  @@index([ratingAvg])
  @@index([catalogReviewedAt])
  @@index([catalogReviewedByUserId])
  @@map("products")
}

model AttributeDefinition {
  id            String                  @id @default(uuid()) @db.Uuid
  code          String                  @unique @db.VarChar(80)
  nameAr        String                  @map("name_ar") @db.VarChar(160)
  nameEn        String?                 @map("name_en") @db.VarChar(160)
  description   String?                 @db.Text
  dataType      AttributeDataType       @map("data_type")
  unit          String?                 @db.VarChar(40)
  allowedValues Json?                   @map("allowed_values") @db.JsonB
  isActive      Boolean                 @default(true) @map("is_active")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileItems  AttributeProfileItem[]
  productValues ProductAttributeValue[]

  @@index([isActive])
  @@map("attribute_definitions")
}

model AttributeProfile {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(160)
  description String?                @db.Text
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  items       AttributeProfileItem[]
  categories  Category[]

  @@index([isActive])
  @@map("attribute_profiles")
}

model AttributeProfileItem {
  id                    String              @id @default(uuid()) @db.Uuid
  profileId             String              @map("profile_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  required              Boolean             @default(false)
  filterable            Boolean             @default(false)
  comparable            Boolean             @default(false)
  visibleOnProduct      Boolean             @default(true) @map("visible_on_product")
  visibleInSummary      Boolean             @default(false) @map("visible_in_summary")
  sortOrder             Int                 @default(0) @map("sort_order")
  profile               AttributeProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([profileId, attributeDefinitionId])
  @@index([profileId, sortOrder])
  @@index([attributeDefinitionId])
  @@map("attribute_profile_items")
}

model ProductAttributeValue {
  id                    String              @id @default(uuid()) @db.Uuid
  productId             String              @map("product_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  textValue             String?             @map("text_value") @db.Text
  numberValue           Decimal?            @map("number_value") @db.Decimal(20, 6)
  booleanValue          Boolean?            @map("boolean_value")
  jsonValue             Json?               @map("json_value") @db.JsonB
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId, textValue])
  @@index([attributeDefinitionId, numberValue])
  @@index([attributeDefinitionId, booleanValue])
  @@map("product_attribute_values")
}

model ProductSourceIdentity {
  id                         String    @id @default(uuid()) @db.Uuid
  productId                  String    @map("product_id") @db.Uuid
  sourceSystem               String    @map("source_system") @db.VarChar(60)
  externalId                 String    @map("external_id") @db.VarChar(160)
  sourceBarcode              String?   @map("source_barcode") @db.VarChar(120)
  lastImportedPrice          Decimal?  @map("last_imported_price") @db.Decimal(12, 4)
  lastImportedName           String?   @map("last_imported_name") @db.VarChar(160)
  lastImportedSourceCategory String?   @map("last_imported_source_category") @db.VarChar(160)
  lastImportedCategoryId     String?   @map("last_imported_category_id") @db.Uuid
  lastImportedAt             DateTime? @map("last_imported_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product                    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, externalId])
  @@index([productId])
  @@index([sourceSystem, sourceBarcode])
  @@map("product_source_identities")
}

model CatalogImportProfile {
  id              String                    @id @default(uuid()) @db.Uuid
  name            String                    @db.VarChar(120)
  sourceSystem    CatalogImportSourceSystem @map("source_system")
  fileFormat      CatalogImportFileFormat   @map("file_format")
  columnMapping   Json                      @map("column_mapping") @db.JsonB
  categoryMapping Json?                     @map("category_mapping") @db.JsonB
  brandMapping    Json?                     @map("brand_mapping") @db.JsonB
  sourceCurrency  BaseCurrency              @default(LYD) @map("source_currency")
  importMode      CatalogImportMode         @default(PRODUCTS_AND_PRICES) @map("import_mode")
  updatePolicy    Json?                     @map("update_policy") @db.JsonB
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        CatalogImportSession[]

  @@unique([name, sourceSystem])
  @@index([sourceSystem])
  @@index([isActive])
  @@map("catalog_import_profiles")
}

model CatalogImportSession {
  id                String                     @id @default(uuid()) @db.Uuid
  profileId         String                     @map("profile_id") @db.Uuid
  initiatedByUserId String?                    @map("initiated_by_user_id") @db.Uuid
  approvedByUserId  String?                    @map("approved_by_user_id") @db.Uuid
  originalFilename  String                     @map("original_filename") @db.VarChar(255)
  storedFileRef     String                     @map("stored_file_ref") @db.VarChar(500)
  fileFormat        CatalogImportFileFormat    @map("file_format")
  fileSizeBytes     Int?                       @map("file_size_bytes")
  fileChecksum      String?                    @map("file_checksum") @db.VarChar(128)
  totalRows         Int                        @default(0) @map("total_rows")
  newCount          Int                        @default(0) @map("new_count")
  unchangedCount    Int                        @default(0) @map("unchanged_count")
  changedCount      Int                        @default(0) @map("changed_count")
  conflictCount     Int                        @default(0) @map("conflict_count")
  invalidCount      Int                        @default(0) @map("invalid_count")
  appliedCount      Int                        @default(0) @map("applied_count")
  skippedCount      Int                        @default(0) @map("skipped_count")
  status            CatalogImportSessionStatus @default(UPLOADED)
  startedAt         DateTime?                  @map("started_at") @db.Timestamptz(6)
  analyzedAt        DateTime?                  @map("analyzed_at") @db.Timestamptz(6)
  approvedAt        DateTime?                  @map("approved_at") @db.Timestamptz(6)
  appliedAt         DateTime?                  @map("applied_at") @db.Timestamptz(6)
  completedAt       DateTime?                  @map("completed_at") @db.Timestamptz(6)
  failureSummary    String?                    @map("failure_summary") @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile           CatalogImportProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  initiatedBy       User?                      @relation("ImportInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?                      @relation("ImportApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rows              CatalogImportRow[]

  @@index([profileId])
  @@index([status])
  @@index([initiatedByUserId])
  @@map("catalog_import_sessions")
}

model CatalogImportRow {
  id               String                 @id @default(uuid()) @db.Uuid
  sessionId        String                 @map("session_id") @db.Uuid
  rowNumber        Int                    @map("row_number")
  rawValues        Json                   @map("raw_values") @db.JsonB
  normalizedValues Json?                  @map("normalized_values") @db.JsonB
  matchedProductId String?                @map("matched_product_id") @db.Uuid
  status           CatalogImportRowStatus @default(NEW)
  validationErrors Json?                  @map("validation_errors") @db.JsonB
  detectedChanges  Json?                  @map("detected_changes") @db.JsonB
  applyResult      Json?                  @map("apply_result") @db.JsonB
  appliedAt        DateTime?              @map("applied_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  session          CatalogImportSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchedProduct   Product?               @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)

  @@unique([sessionId, rowNumber])
  @@index([sessionId, status])
  @@index([matchedProductId])
  @@map("catalog_import_rows")
}

model HomepageBlock {
  id        String            @id @default(uuid()) @db.Uuid
  type      HomepageBlockType
  title     String            @db.VarChar(160)
  subtitle  String?           @db.VarChar(255)
  config    Json?             @db.JsonB
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([sortOrder])
  @@index([type])
  @@map("homepage_blocks")
}

model RecentlyViewedItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(191)
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([sessionId, productId])
  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@map("recently_viewed_items")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String?          @db.Text
  link      String?          @db.VarChar(500)
  metadata  Json?            @db.JsonB
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(false) @map("is_active")
  config      Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("themes")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  imageUrl  String  @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  sessionId String?    @unique @map("session_id") @db.VarChar(191)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id                String          @id @default(uuid()) @db.Uuid
  cartId            String          @map("cart_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  variantName       String?         @map("variant_name") @db.VarChar(255)
  variantAttributes Json?           @map("variant_attributes") @db.JsonB
  quantity          Int
  unitPrice         Decimal         @map("unit_price") @db.Decimal(12, 4)
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  sessionId           String?              @map("session_id") @db.VarChar(191)
  addressId           String?              @map("address_id") @db.Uuid
  orderNumber         String?              @unique @map("order_number") @db.VarChar(40)
  idempotencyKey      String?              @unique @map("idempotency_key") @db.VarChar(255)
  fullName            String               @map("full_name") @db.VarChar(160)
  phone               String               @db.VarChar(30)
  city                String               @db.VarChar(120)
  address             String               @db.VarChar(255)
  notes               String?              @db.Text
  paymentMethod       PaymentMethodCode?   @map("payment_method")
  paymentStatus       OrderPaymentStatus   @default(PENDING) @map("payment_status")
  totalAmount         Decimal              @map("total_amount") @db.Decimal(12, 4)
  status              OrderStatus          @default(PENDING)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  savedAddress        Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]
  statusHistory       OrderStatusHistory[]

  @@index([addressId])
  @@index([userId])
  @@index([sessionId])
  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  status          OrderStatus
  note            String?     @db.Text
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([changedByUserId])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  variantId         String?         @map("variant_id") @db.Uuid
  variantName       String?         @map("variant_name") @db.VarChar(255)
  variantAttributes Json?           @map("variant_attributes") @db.JsonB
  productName       String?         @map("product_name") @db.VarChar(255)
  quantity          Int
  unitPrice         Decimal         @map("unit_price") @db.Decimal(12, 4)
  comparePrice      Decimal?        @map("compare_price") @db.Decimal(12, 4)
  baseCurrency      BaseCurrency    @default(LYD) @map("base_currency")
  exchangeRateUsed  Decimal?        @map("exchange_rate_used") @db.Decimal(12, 6)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model PaymentMethod {
  id           String               @id @default(uuid()) @db.Uuid
  code         PaymentMethodCode    @unique
  name         String               @db.VarChar(120)
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  transactions PaymentTransaction[]

  @@index([isActive])
  @@map("payment_methods")
}

model PaymentTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  orderId           String                   @map("order_id") @db.Uuid
  paymentMethodId   String                   @map("payment_method_id") @db.Uuid
  paymentMethodCode PaymentMethodCode        @map("payment_method")
  amount            Decimal                  @db.Decimal(12, 4)
  status            PaymentTransactionStatus @default(PENDING)
  referenceNumber   String?                  @map("reference_number") @db.VarChar(120)
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod            @relation(fields: [paymentMethodId], references: [id])
  receipts          BankTransferReceipt[]

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([paymentMethodCode])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model BankTransferReceipt {
  id                   String              @id @default(uuid()) @db.Uuid
  paymentTransactionId String              @map("payment_transaction_id") @db.Uuid
  fileUrl              String              @map("file_url") @db.VarChar(500)
  uploadedById         String?             @map("uploaded_by") @db.Uuid
  reviewedById         String?             @map("reviewed_by") @db.Uuid
  reviewStatus         ReceiptReviewStatus @default(PENDING) @map("review_status")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentTransaction   PaymentTransaction  @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  uploadedBy           User?               @relation("BankTransferReceiptUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy           User?               @relation("BankTransferReceiptReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([paymentTransactionId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([reviewStatus])
  @@index([createdAt])
  @@map("bank_transfer_receipts")
}

model Ticket {
  id           String          @id @default(uuid()) @db.Uuid
  ticketNumber String          @unique @map("ticket_number") @db.VarChar(40)
  userId       String          @map("user_id") @db.Uuid
  subject      String          @db.VarChar(255)
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model Service {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(160)
  slug        String           @unique @db.VarChar(180)
  description String           @db.Text
  basePrice   Decimal?         @map("base_price") @db.Decimal(12, 4)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  requests    ServiceRequest[]

  @@index([isActive])
  @@map("services")
}

model ServiceRequest {
  id            String               @id @default(uuid()) @db.Uuid
  serviceId     String               @map("service_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  customerName  String               @map("customer_name") @db.VarChar(160)
  customerPhone String               @map("customer_phone") @db.VarChar(30)
  preferredDate DateTime?            @map("preferred_date") @db.Date
  addressText   String               @map("address_text") @db.VarChar(255)
  notes         String?              @db.Text
  status        ServiceRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  service       Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("service_requests")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model PriceHistory {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  oldBasePrice     Decimal      @map("old_base_price") @db.Decimal(12, 4)
  newBasePrice     Decimal      @map("new_base_price") @db.Decimal(12, 4)
  oldComparePrice  Decimal?     @map("old_compare_price") @db.Decimal(12, 4)
  newComparePrice  Decimal?     @map("new_compare_price") @db.Decimal(12, 4)
  oldCurrency      BaseCurrency @map("old_currency")
  newCurrency      BaseCurrency @map("new_currency")
  exchangeRateUsed Decimal      @map("exchange_rate_used") @db.Decimal(12, 6)
  changeReason     String?      @map("change_reason") @db.VarChar(255)
  changedByUserId  String?      @map("changed_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedByUser    User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([changedByUserId])
  @@index([createdAt])
  @@map("price_history")
}

model SearchTerm {
  id             String   @id @default(uuid()) @db.Uuid
  term           String   @db.VarChar(255)
  hitCount       Int      @default(1) @map("hit_count")
  lastSearchedAt DateTime @default(now()) @map("last_searched_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([term])
  @@index([hitCount])
  @@index([lastSearchedAt])
  @@index([updatedAt])
  @@map("search_terms")
}

model Review {
  id                 String        @id @default(uuid()) @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  orderId            String?       @map("order_id") @db.Uuid
  rating             Int
  title              String?       @db.VarChar(160)
  comment            String?       @db.Text
  status             ReviewStatus  @default(PENDING)
  isVerifiedPurchase Boolean       @default(false) @map("is_verified_purchase")
  helpfulCount       Int           @default(0) @map("helpful_count")
  moderatorNote      String?       @map("moderator_note") @db.Text
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images             ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([isVerifiedPurchase])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model ProductQnA {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  status     QnAStatus @default(PENDING)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("product_qna")
}

model ProductVariant {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  sku          String?     @unique @db.VarChar(120)
  name         String?     @db.VarChar(160)
  attributes   Json        @db.JsonB
  price        Decimal     @db.Decimal(12, 4)
  comparePrice Decimal?    @map("compare_price") @db.Decimal(12, 4)
  stockQty     Int         @map("stock_qty")
  imageUrl     String?     @map("image_url") @db.VarChar(500)
  isDefault    Boolean     @default(false) @map("is_default")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Bundle {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(180)
  description String?      @db.Text
  bundlePrice Decimal?     @map("bundle_price") @db.Decimal(12, 4)
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  items       BundleItem[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid()) @db.Uuid
  bundleId  String  @map("bundle_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int     @default(1)
  sortOrder Int     @default(0) @map("sort_order")
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@index([productId])
  @@map("bundle_items")
}

model ProductRelation {
  id           String              @id @default(uuid()) @db.Uuid
  sourceId     String              @map("source_id") @db.Uuid
  targetId     String              @map("target_id") @db.Uuid
  relationType ProductRelationType @map("relation_type")
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  source       Product             @relation("SourceProduct", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Product             @relation("TargetProduct", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, relationType])
  @@index([targetId])
  @@map("product_relations")
}

model MediaAsset {
  id                String                @id @default(uuid()) @db.Uuid
  mediaType         MediaType             @default(IMAGE) @map("media_type")
  originalFilename  String                @map("original_filename") @db.VarChar(255)
  storageKey        String                @map("storage_key") @db.VarChar(500)
  originalMimeType  String                @map("original_mime_type") @db.VarChar(120)
  originalSizeBytes Int                   @map("original_size_bytes")
  originalWidth     Int?                  @map("original_width")
  originalHeight    Int?                  @map("original_height")
  checksumSha256    String?               @unique @map("checksum_sha256") @db.Char(64)
  aspectRatio       Decimal?              @map("aspect_ratio") @db.Decimal(10, 4)
  altText           String?               @map("alt_text") @db.VarChar(255)
  title             String?               @db.VarChar(160)
  caption           String?               @db.Text
  processingStatus  MediaProcessingStatus @default(PROCESSING) @map("processing_status")
  variants          Json?                 @db.JsonB
  uploadedById      String?               @map("uploaded_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  uploadedBy        User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productMedia      ProductMedia[]

  @@index([mediaType])
  @@index([processingStatus])
  @@index([createdAt])
  @@index([uploadedById])
  @@map("media_assets")
}

model ProductMedia {
  id           String           @id @default(uuid()) @db.Uuid
  productId    String           @map("product_id") @db.Uuid
  mediaAssetId String           @map("media_asset_id") @db.Uuid
  role         ProductMediaRole @default(GALLERY)
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@unique([productId, sortOrder])
  @@index([productId, role])
  @@index([mediaAssetId])
  @@map("product_media")
}
